# Settings for the experiment pool (experiments/pool/run_task.sh). Copy to local.env and fill in;
# local.env is gitignored. Model ids are provider-prefixed (docs/PROVIDERS.md); a comma makes a
# fallback chain.
STUDENT_MODEL=ibm-granite/granite-4.1-3b
# primary judge for every table in the paper, and two swap judges for exp03
JUDGE=oai-<provider>/<judge-model>,oai-<fallback-provider>/<judge-model>
JUDGE_SWAP_A=oai-<provider>/<second-judge>
JUDGE_SWAP_B=oai-<provider>/<third-judge>
# the teacher: guides nothing here, but is the agent in the teacher-alone arms (exp01, exp08)
TEACHER=oai-<provider>/<teacher-model>
# checkout of the research workspace whose E00/E13 runs exp00_reference/import_runs.py re-imports
RESEARCH_ROOT=/path/to/teacher-guidence
# optional knobs (defaults shown)
# JUDGE_CONCURRENCY=8
# TEACHER_CONCURRENCY=6
# TEACHER_AGENT_MAX_TOKENS=6000   # a reasoning model spends most of this before it answers
# TEACHDIST_N=1000                # questions per dataset for exp01's teacher-alone set
# TEACHDIST_SHARDS=4
# publishing into results/ (tools.py publish): provider prefixes of your site to strip from model
# ids, and names that must never appear in a published file (gateways, cluster and host names)
# PUBLISH_STRIP='<prefix>|<prefix/sub>'      # quoted: the values are regex alternations
# PUBLISH_FORBID='<gateway>|<cluster>|<host1>|<host2>'
