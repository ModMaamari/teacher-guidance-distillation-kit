# environments and caches
.venv/
.venv_train/
.venv_vllm/
.venv*/
.cache/
__pycache__/
*.pyc
.pytest_cache/
.env

# run artifacts
runs/*
!runs/.gitkeep
templates/simulations/*
!templates/simulations/.gitkeep

# SFT train/dev files: large and rebuilt deterministically from data/episodes
# with `make data` (~2 min; scripts/build_splits.py). The test question files,
# the pool assignment, the stats and the leakage report ARE tracked.
data/splits/uniform/train.jsonl
data/splits/uniform/dev.jsonl
data/splits/lodo/*/train.jsonl
data/splits/lodo/*/dev.jsonl
# training-set-size ablation splits, rebuilt by scripts/make_size_splits.py
data/splits/uniform_ep*/

# experiment pool: site settings, and the training splits and episode sets it derives
experiments/pool/local.env
data/splits_*/
data/episodes_selfdist/
data/episodes_teachdist/

# E27: downloaded benchmarks, their converted copies and the Wikipedia article cache. These are
# reproduced by experiments/exp27_new_benchmarks/build_datasets.py and carry their own upstream
# licences, so the kit ships the converter rather than the data.
data/_raw/
data/_cache/
data/questions/multihoprag/
data/questions/framesqa/
data/splits/test/newtest_*
# episode sets the pool derives (large, rebuilt by consolidate_episodes.py)
data/episodes_oracle_*/
data/episodes_teachdist_or/
