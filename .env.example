# Copy to .env and fill in what you use. Never commit .env.
#
# --- generic OpenAI-compatible endpoints (recommended for teacher and judge) ---------
# Model ids: oai/<model> uses OAI_*; oai-<name>/<model> uses OAI_<NAME>_* (name upper-cased).
OAI_BASE_URL=https://api.example.com/v1
OAI_API_KEY=
OAI_TEACHER_BASE_URL=
OAI_TEACHER_API_KEY=
OAI_JUDGE_BASE_URL=
OAI_JUDGE_API_KEY=
OAI_TIMEOUT=180

# --- local student server (scripts/serve_vllm.sh); model ids: vllm/<served-name> ------
VLLM_ENDPOINT=http://127.0.0.1:8300

# --- other supported providers (optional) ---------------------------------------------
# EdenAI aggregator: edenchat/<provider>/<model> (chat-completions) or edenai/<provider>/<model>
EDENAI_API_KEY=
# NVIDIA NIM: nvidia/<model>
NVIDIA_API_KEY=
# OpenRouter-style endpoint: custom/<model>
CUSTOM_LLM_ENDPOINT=
CUSTOM_LLM_API_KEY=
# Native SDKs: plain model names (gpt-4o, claude-..., gemini-..., mistral-...)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
# Ollama: ollama/<model>
OLLAMA_ENDPOINT=http://localhost:11434

# --- caches (compute nodes often have a read-only home) --------------------------------
# HF_HOME=/path/with/space/.cache/hf

# Extra chat-template args for the local vLLM student, as JSON. QUOTE IT: the value
# contains a space, and an unquoted value is split by the shell when this file is
# sourced, leaving the variable unset with only a "command not found" on stderr.
#VLLM_CHAT_TEMPLATE_KWARGS='{"enable_thinking": false}'

# OpenRouter routing for custom/<model>: pin the provider, and set reasoning to
# off|minimal|low|medium|high|exclude (some models refuse "off" outright).
#OPENROUTER_PROVIDER_ONLY=DeepInfra
#OPENROUTER_REASONING=low
